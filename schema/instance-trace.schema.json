{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haslab.github.io/alloy-a4f-visualizer/instance-trace.schema.json",
  "title": "Alloy visualizer instance or trace",
  "description": "Canonical document exchanged with the standalone visualizer.",
  "type": "object",
  "required": ["states", "loop"],
  "properties": {
    "states": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/state" }
    },
    "loop": {
      "type": "integer",
      "minimum": -1,
      "description": "-1 for a single instance; otherwise the zero-based trace loop target."
    },
    "scope": { "$ref": "#/$defs/scope" }
  },
  "allOf": [
    {
      "if": { "properties": { "loop": { "const": -1 } } },
      "then": { "properties": { "states": { "maxItems": 1 } } }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "state": {
      "type": "object",
      "required": ["types", "sets", "rels"],
      "properties": {
        "types": { "type": "array", "items": { "$ref": "#/$defs/type" } },
        "sets": { "type": "array", "items": { "$ref": "#/$defs/subset" } },
        "rels": { "type": "array", "items": { "$ref": "#/$defs/relation" } }
      },
      "additionalProperties": true
    },
    "type": {
      "description": "A type has at most one immediate parent (none for a root).",
      "allOf": [
        { "$ref": "#/$defs/node" },
        { "properties": { "parents": { "maxItems": 1 } } }
      ]
    },
    "subset": {
      "description": "A subset may have multiple parents, as in sig S in A + B.",
      "allOf": [{ "$ref": "#/$defs/node" }]
    },
    "node": {
      "type": "object",
      "required": ["name", "atoms"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "isVar": { "type": "boolean" },
        "parents": { "type": "array", "items": { "type": "string" } },
        "parent": { "type": ["string", "null"], "description": "Legacy Alloy4Fun single-parent representation; parents takes precedence." },
        "atoms": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "relation": {
      "type": "object",
      "required": ["name", "atoms"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "arity": { "type": "integer", "minimum": 0 },
        "types": { "type": "array", "items": { "type": "string" } },
        "atoms": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string" } }
        }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "object",
      "properties": {
        "bitwidth": { "type": "integer" },
        "maxseq": { "type": "integer" },
        "mintrace": { "type": "integer" },
        "maxtrace": { "type": "integer" }
      },
      "additionalProperties": true
    }
  }
}
