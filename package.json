{
  "name": "alloy-a4f-visualizer",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "files": [
    "src/",
    "schema/",
    "docs/",
    "LICENSES/",
    "demo/examples/"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "description": "Standalone, reusable visualization for Alloy instances and traces",
  "repository": {
    "type": "git",
    "url": "https://github.com/haslab/alloy-a4f-visualizer.git"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./graph-model": "./src/graphModel.js",
    "./renderer": "./src/graphRenderer.js",
    "./style": "./src/cytoscapeStyle.js",
    "./interactions": "./src/graphInteractions.js",
    "./theme": "./src/themeModel.js",
    "./visualizer.css": "./src/visualizer.css",
    "./src/visualizer.css": "./src/visualizer.css",
    "./schema": "./schema/instance-trace.schema.json"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:browser": "playwright test",
    "test:projection": "node test/run-projection-ground-truth.mjs",
    "test:package": "node test/package-smoke.mjs",
    "check": "npm test && npm run test:package && npm run test:browser",
    "demo": "node demo/server.js"
  },
  "dependencies": {
    "cytoscape": "^3.35.0"
  },
  "devDependencies": {
    "@fortawesome/free-solid-svg-icons": "5.6.3",
    "@playwright/test": "^1.60.0"
  }
}
